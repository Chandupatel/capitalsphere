# Admin inbox that receives every consultation-form submission.
ADMIN_EMAIL=info@capitalsphere.in

# SMTP credentials used to send that email (nodemailer).
# Works with Gmail (use an App Password), Zoho, SendGrid SMTP, Amazon SES SMTP, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
