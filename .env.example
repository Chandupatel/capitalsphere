# Admin inbox that receives every consultation-form submission.
ADMIN_EMAIL=info@capitalspherebusinesssolutions.in

# SMTP credentials used to send emails (nodemailer).
# On submit: an enquiry notification goes to ADMIN_EMAIL,
# and a thank-you confirmation goes to the visitor.
# Works with Gmail (use an App Password), Zoho, SendGrid SMTP, Amazon SES SMTP, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
